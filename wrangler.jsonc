{
  "name": "yes-or-no-puzzle",
  "main": "src/extractor-worker.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "extractor-public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "EXTRACTIONS",
        "class_name": "Extraction"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2-extraction",
      "new_sqlite_classes": [
        "Extraction"
      ]
    }
  ],
  "vars": {},
  "observability": {
    "enabled": false
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "soup.yingxinzone.top",
      "custom_domain": true
    }
  ]
}
